        sh:minLength 1 ;
        sh:maxLength 256 ;
        sh:pattern "^([\\x09\\x0a\\x0d\\x20-\\ud7ff\\ue000-\\ufffd]|\\ud800[\\udc00-\\udfff]|[\\ud801-\\udbfe][\\udc00-\\udfff]|\\udbff[\\udc00-\\udfff])*$" ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path <https://admin-shell.io/aas/3/2/DataSpecificationUom/classificationSystemVersion> ;
        sh:datatype xs:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:minLength 1 ;
        sh:maxLength 256 ;
        sh:pattern "^([\\x09\\x0a\\x0d\\x20-\\ud7ff\\ue000-\\ufffd]|\\ud800[\\udc00-\\udfff]|[\\ud801-\\udbfe][\\udc00-\\udfff]|\\udbff[\\udc00-\\udfff])*$" ;
    ] ;
.

aas:EmbeddedDataSpecificationShape a sh:NodeShape ;
    sh:targetClass aas:EmbeddedDataSpecification ;
    sh:property [
        a sh:PropertyShape ;
        sh:path <https://admin-shell.io/aas/3/2/EmbeddedDataSpecification/dataSpecification> ;
        sh:class aas:Reference ;
